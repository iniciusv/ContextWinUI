<ContentDialog
    x:Class="ContextWinUI.Features.DatabaseContext.Views.AddConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Add Database Connection"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <Style x:Key="StandardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"/>
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"/>
    </ContentDialog.Resources>
    
    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"/>
    </ContentDialog.PrimaryButtonStyle>

    <ContentDialog.CloseButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"/>
    </ContentDialog.CloseButtonStyle>

    <StackPanel Spacing="16" MinWidth="350">
        <TextBox Header="Connection Name" 
                 Text="{x:Bind ConnectionName, Mode=TwoWay}"
                 PlaceholderText="e.g. Production DB"/>
        
        <TextBox Header="Connection String" 
                 Text="{x:Bind ConnectionString, Mode=TwoWay}"
                 PlaceholderText="Server=...;Database=...;"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Height="100"/>
                 
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}" 
                       Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                       VerticalAlignment="Center"
                       FontSize="12"/>
                       
            <Button Grid.Column="1" Content="Test Connection" Click="TestConnection_Click"/>
        </Grid>
    </StackPanel>
</ContentDialog>
