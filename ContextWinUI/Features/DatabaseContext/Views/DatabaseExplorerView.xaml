<UserControl
    x:Class="ContextWinUI.Features.DatabaseContext.Views.DatabaseExplorerView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ContextWinUI.Features.DatabaseContext.ViewModels"
    xmlns:models="using:ContextWinUI.Models"
    xmlns:components="using:ContextWinUI.Views.Components"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Search -->
            <RowDefinition Height="Auto"/> <!-- Config (Connection/Schema) -->
            <RowDefinition Height="Auto"/> <!-- Selection Actions -->
            <RowDefinition Height="*"/>    <!-- List -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F8;" FontSize="16"/> <!-- Database Icon -->
                <TextBlock Text="Database" Style="{StaticResource SubtitleTextBlockStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Click="AddConnection_Click" 
                        ToolTipService.ToolTip="Add Connection"
                        Style="{StaticResource SubtleButtonStyle}" Padding="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                </Button>
                <Button Command="{x:Bind ViewModel.RefreshConnectionCommand}"
                        ToolTipService.ToolTip="Refresh Schema"
                        Style="{StaticResource SubtleButtonStyle}" Padding="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search -->
        <components:SearchBar Grid.Row="1" 
                              SearchCommand="{x:Bind ViewModel.SearchCommand}" 
                              SubmitCommand="{x:Bind ViewModel.SubmitSearchCommand}"
                              PlaceholderText="Search tables..."
                              Margin="16,0,16,8"/>

        <!-- Configuration (Connection / Schema) -->
        <Grid Grid.Row="2" ColumnSpacing="8" Padding="16,0,16,8">
             <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <ComboBox Grid.Column="0" 
                      ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedConnection, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="Name"
                      PlaceholderText="Connection"
                      ToolTipService.ToolTip="Select Connection"/>

             <ComboBox Grid.Column="1" 
                       ItemsSource="{x:Bind ViewModel.Schemas, Mode=OneWay}"
                       SelectedItem="{x:Bind ViewModel.SelectedSchema, Mode=TwoWay}"
                       HorizontalAlignment="Stretch"
                       PlaceholderText="Schema"
                       ToolTipService.ToolTip="Select Schema"/>
        </Grid>

        <!-- Selection Toolbar -->
        <Grid Grid.Row="3" Padding="16,8" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="All" 
                    Command="{x:Bind ViewModel.SelectAllCommand}" 
                    Style="{StaticResource AccentButtonStyle}" 
                    Margin="0,0,8,0" FontSize="11" Padding="8,4" Height="28"/>
            <Button Grid.Column="1" 
                    Content="None" 
                    Command="{x:Bind ViewModel.UnselectAllCommand}" 
                    Margin="0,0,8,0" FontSize="11" Padding="8,4" Height="28"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.SelectionViewModel.SelectedTablesCount, Mode=OneWay}" FontWeight="SemiBold"/>
                <TextBlock Text="selected" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- List -->
        <ListView Grid.Row="4"
                  x:Name="TableList"
                  ItemsSource="{x:Bind ViewModel.Tables, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="TableList_ItemClick">
             <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="24"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,1"/>
                </Style>
             </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DatabaseTableItem">
                     <Grid Height="24" Padding="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                            <ColumnDefinition Width="Auto"/> <!-- Icon -->
                            <ColumnDefinition Width="*"/>    <!-- Name -->
                            <ColumnDefinition Width="Auto"/> <!-- Details -->
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox Grid.Column="0" 
                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}" 
                                  MinWidth="0" Padding="0" VerticalAlignment="Center" 
                                  Margin="8,0,4,0"/>
                        
                        <FontIcon Grid.Column="1" Glyph="&#xE7F8;" FontSize="14" Margin="0,0,8,0" 
                                  Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        
                        <TextBlock Grid.Column="2" 
                                   Text="{x:Bind Name}" 
                                   VerticalAlignment="Center" 
                                   FontSize="13"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
