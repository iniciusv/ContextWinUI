<UserControl
    x:Class="ContextWinUI.Features.GraphParser.GraphParserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:vm="using:ContextWinUI.Features.GraphParser.ViewModels"
    xmlns:views="using:ContextWinUI.Features.GraphParser"
    xmlns:iap="using:ContextWinUI.Features.GraphParser"
    mc:Ignorable="d">

	<UserControl.Resources>
		<converters:BoolToVisibilityConverter x:Key="ReverseBoolToVis" TrueValue="Collapsed" FalseValue="Visible"/>
		<converters:BoolToVisibilityConverter x:Key="BoolToVis" />

		<views:TabHeaderTemplateSelector x:Key="HeaderSelector">
			<views:TabHeaderTemplateSelector.FileHeaderTemplate>
				<DataTemplate x:DataType="vm:FileSegmentsViewModel">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<SymbolIcon Symbol="Document" />
						<TextBlock Text="{x:Bind FileName}" VerticalAlignment="Center"/>
					</StackPanel>
				</DataTemplate>
			</views:TabHeaderTemplateSelector.FileHeaderTemplate>
			<views:TabHeaderTemplateSelector.PreviewHeaderTemplate>
				<DataTemplate x:DataType="iap:AiPreviewViewModel">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<SymbolIcon Symbol="Highlight" Foreground="{ThemeResource SystemAccentColor}"/>
						<TextBlock Text="{x:Bind Title}" VerticalAlignment="Center"/>
					</StackPanel>
				</DataTemplate>
			</views:TabHeaderTemplateSelector.PreviewHeaderTemplate>
		</views:TabHeaderTemplateSelector>

		<DataTemplate x:Key="EmptyContentTemplate">
			<Grid Height="0" />
		</DataTemplate>

		<DataTemplate x:Key="ProxyHeaderTemplate">
			<ContentControl Content="{Binding}" 
                            ContentTemplateSelector="{StaticResource HeaderSelector}" 
                            HorizontalContentAlignment="Stretch" 
                            VerticalContentAlignment="Stretch"/>
		</DataTemplate>

		<views:TabContentTemplateSelector x:Key="ContentSelector">
			<views:TabContentTemplateSelector.FileTemplate>
				<DataTemplate x:DataType="vm:FileSegmentsViewModel">
					<views:FileSegmentsView DataContext="{Binding}"/>
				</DataTemplate>
			</views:TabContentTemplateSelector.FileTemplate>
			<views:TabContentTemplateSelector.PreviewTemplate>
				<DataTemplate x:DataType="iap:AiPreviewViewModel">
					<iap:AiPreviewView DataContext="{Binding}"/>
				</DataTemplate>
			</views:TabContentTemplateSelector.PreviewTemplate>
		</views:TabContentTemplateSelector>
	</UserControl.Resources>

	<Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" 
              Padding="12,8" 
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
              BorderThickness="0,0,0,1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        Spacing="8" 
                        VerticalAlignment="Center" 
                        Margin="0,0,12,0">
                <Button Command="{x:Bind ViewModel.SyncToExplorerCommand}"
                        ToolTipService.ToolTip="Sincronizar com Explorador de Arquivos">
                    <FontIcon Glyph="&#xE751;" FontSize="16"/> <!-- GoTo/Arrow icon -->
                </Button>

                <Button Command="{x:Bind ViewModel.CheckCurrentFileCommand}"
                        ToolTipService.ToolTip="Selecionar/Marcar Arquivo">
                    <FontIcon Glyph="&#xE73E;" FontSize="16"/> <!-- CheckMark icon -->
                </Button>

                <Button ToolTipService.ToolTip="Visualização">
                    <Button.Content>
                        <FontIcon Glyph="&#xE713;" FontSize="16"/>
                    </Button.Content>
                    <Button.Flyout>
                        <MenuFlyout>
                            <ToggleMenuFlyoutItem Text="Mostrar Usings" IsChecked="{x:Bind ViewModel.ShowUsings, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="Mostrar Trivia (Espaços/Comentários)" IsChecked="{x:Bind ViewModel.ShowTrivia, Mode=TwoWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
			</StackPanel>

			<AutoSuggestBox Grid.Column="1"
                            PlaceholderText="Buscar no grafo (arquivos, classes, métodos)..."
                            QueryIcon="Find"
                            ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}"
                            TextChanged="AutoSuggestBox_TextChanged"
                            SuggestionChosen="AutoSuggestBox_SuggestionChosen"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
				<AutoSuggestBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Margin="8,4">
							<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
							<TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Opacity="0.8"/>
							<TextBlock Text="{Binding FilePath}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
						</StackPanel>
					</DataTemplate>
				</AutoSuggestBox.ItemTemplate>
			</AutoSuggestBox>

			<Button Grid.Column="2" 
                    Margin="12,0,0,0"
                    Command="{x:Bind ViewModel.PasteAndMergeFromClipboardCommand}"
                    ToolTipService.ToolTip="Paste AI Snippet and Apply">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<FontIcon Glyph="&#xE77F;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
					<TextBlock Text="Smart Paste"/>
				</StackPanel>
			</Button>
		</Grid>

		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<TabView Grid.Row="0"
                     TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                     SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                     
                     
                     TabItemTemplate="{StaticResource EmptyContentTemplate}"
                     
                     TabCloseRequested="TabView_TabCloseRequested"
                     IsAddTabButtonVisible="False"
                     Padding="0"
                     VerticalAlignment="Top">

				<TabView.Resources>
					<Style TargetType="TabViewItem">
						<Setter Property="HeaderTemplate" Value="{StaticResource ProxyHeaderTemplate}" />
					</Style>
				</TabView.Resources>
			</TabView>

			<ContentControl Grid.Row="1" 
                            Content="{x:Bind ViewModel.SelectedTab, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource ContentSelector}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.HasTabs, Mode=OneWay}">
			</ContentControl>

			<Grid Grid.Row="0" Grid.RowSpan="2" 
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  Visibility="{x:Bind ViewModel.HasTabs, Mode=OneWay, Converter={StaticResource ReverseBoolToVis}}">
				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
					<FontIcon Glyph="&#xE8F4;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
					<TextBlock Text="Use a busca acima ou 'Smart Paste' para começar" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
				</StackPanel>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
