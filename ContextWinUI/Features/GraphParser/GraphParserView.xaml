<UserControl
    x:Class="ContextWinUI.Features.GraphParser.Views.GraphParserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ContextWinUI.Features.GraphParser.ViewModels"
    xmlns:views="using:ContextWinUI.Features.GraphParser.Views"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d">

	<UserControl.Resources>
		<converters:BoolToVisibilityConverter x:Key="ReverseBoolToVis" TrueValue="Collapsed" FalseValue="Visible"/>
	</UserControl.Resources>

	<Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,12,0">
				<FontIcon Glyph="&#xE8F4;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
				<TextBlock Text="Editor Granular" Style="{StaticResource BodyStrongTextBlockStyle}"/>
			</StackPanel>

			<AutoSuggestBox Grid.Column="1"
                PlaceholderText="Buscar no grafo (arquivos, classes, métodos)..."
                QueryIcon="Find"
                ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}"
                TextChanged="AutoSuggestBox_TextChanged"
                SuggestionChosen="AutoSuggestBox_SuggestionChosen"
                HorizontalAlignment="Stretch">
				<AutoSuggestBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Margin="8,4">
							<TextBlock Text="{Binding Title}" 
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
							<TextBlock Text="{Binding Subtitle}" 
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.8"/>
							<TextBlock Text="{Binding FilePath}" 
                           FontSize="10"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
						</StackPanel>
					</DataTemplate>
				</AutoSuggestBox.ItemTemplate>
			</AutoSuggestBox>
		</Grid>

		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<TabView Grid.Row="0"
                     TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                     SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                     TabCloseRequested="TabView_TabCloseRequested"
                     IsAddTabButtonVisible="False"
                     Padding="0"
                     VerticalAlignment="Top">

				<TabView.TabItemTemplate>
					<DataTemplate x:DataType="vm:FileSegmentsViewModel">
						<TabViewItem Header="{x:Bind FileName}">
							<TabViewItem.IconSource>
								<SymbolIconSource Symbol="Document"/>
							</TabViewItem.IconSource>
						</TabViewItem>
					</DataTemplate>
				</TabView.TabItemTemplate>
			</TabView>

			<ContentControl Grid.Row="1" 
                        Content="{x:Bind ViewModel.SelectedTab, Mode=OneWay}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.HasTabs, Mode=OneWay}">
				<ContentControl.ContentTemplate>
					<DataTemplate x:DataType="vm:FileSegmentsViewModel">
						<views:FileSegmentsView DataContext="{Binding}"/>
					</DataTemplate>
				</ContentControl.ContentTemplate>
			</ContentControl>
			<Grid Grid.Row="0" Grid.RowSpan="2" 
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  Visibility="{x:Bind ViewModel.HasTabs, Mode=OneWay, Converter={StaticResource ReverseBoolToVis}}">

				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
					<FontIcon Glyph="&#xE8F4;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
					<TextBlock Text="Use a busca acima para abrir um arquivo" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
				</StackPanel>
			</Grid>
		</Grid>
	</Grid>
</UserControl>