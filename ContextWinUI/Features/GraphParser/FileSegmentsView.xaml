<UserControl
    x:Class="ContextWinUI.Features.GraphParser.FileSegmentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:viewmodels="using:ContextWinUI.Features.GraphParser.ViewModels"
    xmlns:components="using:ContextWinUI.Features.GraphParser.Views.Components"
    xmlns:ext="using:ContextWinUI.Features.GraphParser.Models"
    xmlns:localConverters="using:ContextWinUI.Utils"
    mc:Ignorable="d"
    x:Name="RootControl">

	<UserControl.Resources>
		<converters:BoolToVisibilityConverter x:Key="BoolToVis" />
		<converters:BoolToVisibilityConverter x:Key="ReverseBoolToVis" TrueValue="Collapsed" FalseValue="Visible"/>
		<localConverters:LineCountToVisibilityConverter x:Key="LineCountToVis" />
	</UserControl.Resources>

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsOpen="True">
			<AppBarButton Icon="Save" 
                          Label="Save Global Version" 
                          Command="{x:Bind ViewModel.CommitAllPendingChangesCommand}" />

			<AppBarButton Icon="Undo" 
                          Label="Restore Original" 
                          Command="{x:Bind ViewModel.RevertBlockToOriginalCommand}" 
                          CommandParameter="{x:Bind ViewModel.SelectedBlock, Mode=OneWay}" />
		</CommandBar>

		<ListView x:Name="MainListView"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                  SelectionMode="None"
                  Padding="0"
                  CanDragItems="True"
                  DragItemsStarting="OnDragItemsStarting">

			<ListView.ItemContainerStyle>
				<Style TargetType="ListViewItem">
					<Setter Property="VerticalContentAlignment" Value="Top"/>
					<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
					<Setter Property="Padding" Value="0"/>
					<Setter Property="Margin" Value="0"/>
					<Setter Property="MinHeight" Value="0"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ListViewItem">
								<ContentPresenter />
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ListView.ItemContainerStyle>

			<ListView.ItemTemplate>
				<DataTemplate x:DataType="viewmodels:SegmentRowViewModel">
					<Grid Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                          BorderThickness="0,0,0,1"
                          AllowDrop="True"
                          DragOver="OnItemDragOver"
                          Drop="OnItemDrop"
                          Background="Transparent">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="{Binding ElementName=RootControl, Path=ViewModel.LeftColumnWidth, Mode=OneWay}"/>
							<ColumnDefinition Width="85"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Grid Grid.Column="0"
                              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                              BorderThickness="0,0,1,0"
                              Visibility="{x:Bind HasReference, Mode=OneWay, Converter={StaticResource BoolToVis}}">

							<components:SegmentCodeViewer 
                                    Text="{x:Bind Reference.Content, Mode=OneWay}" 
                                    FileExtension="{x:Bind Reference.FileExtension, Mode=OneWay}"
                                    IsReadOnly="True"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch"/>
						</Grid>

						<Grid Grid.Column="1" 
                              Background="{ThemeResource LayerFillColorAltBrush}" 
                              Padding="8,0" 
                              BorderThickness="0,0,1,0" 
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              ToolTipService.ToolTip="{x:Bind Current.Name}"
                              PointerPressed="OnBlockPointerPressed">

							<Grid.ContextFlyout>
								<MenuFlyout>
									<MenuFlyoutItem Text="Insert Block Below" Icon="Add"
                                                    Command="{Binding ElementName=RootControl, Path=ViewModel.AddSiblingBlockCommand}"
                                                    CommandParameter="{x:Bind Current}"/>

									<MenuFlyoutItem Text="Delete Block" Icon="Delete" Foreground="Red"
                                                    Command="{Binding ElementName=RootControl, Path=ViewModel.DeleteBlockCommand}"
                                                    CommandParameter="{x:Bind Current}"/>

									<MenuFlyoutSeparator/>

									<MenuFlyoutItem Text="Revert to Original" Icon="Undo"
                                                    Command="{Binding ElementName=RootControl, Path=ViewModel.RevertBlockToOriginalCommand}"
                                                    CommandParameter="{x:Bind Current}"/>

									<MenuFlyoutItem Text="Unlink (Treat as New)"
                                                    Command="{Binding ElementName=RootControl, Path=ViewModel.PromoteEditToNewBlockCommand}"
                                                    CommandParameter="{x:Bind Current}">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE106;"/>
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
								</MenuFlyout>
							</Grid.ContextFlyout>

							<Rectangle x:Name="SelectionIndicator"
                                       Fill="{ThemeResource SystemAccentColor}"
                                       Width="3" HorizontalAlignment="Left" Visibility="Collapsed"
                                       Canvas.ZIndex="10"
                                       Margin="-8,0,0,0"/>

							<Rectangle HorizontalAlignment="Left" Width="3" VerticalAlignment="Stretch" 
                                       Fill="{x:Bind ext:CodeBlockUiExtensions.GetHeaderBrush(Current)}" 
                                       Margin="-8,0,0,0"/>

							<StackPanel Orientation="Vertical" Spacing="4" VerticalAlignment="Center" Opacity="0.9">

								<FontIcon Glyph="&#xE81C;" FontSize="10" Foreground="Orange"
                                          HorizontalAlignment="Left"
                                          Visibility="{x:Bind Current.HasUnsavedChanges, Converter={StaticResource BoolToVis}}"/>

								<FontIcon Glyph="{x:Bind ext:CodeBlockUiExtensions.GetIcon(Current)}" 
                                          Foreground="{x:Bind ext:CodeBlockUiExtensions.GetHeaderBrush(Current)}" 
                                          FontSize="14" HorizontalAlignment="Left"
                                          Visibility="{x:Bind Current.Content, Converter={StaticResource LineCountToVis}, ConverterParameter='HideIfSmall'}"/>

								<TextBlock Text="{x:Bind Current.TypeDescription}" 
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>

								<TextBlock Text="{x:Bind Current.Name}" 
                                           FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind Current.Content, Converter={StaticResource LineCountToVis}, ConverterParameter='HideIfSmall'}"/>

								<StackPanel Orientation="Vertical" Spacing="0" Margin="0,4,0,0" Opacity="0.6"
                                            Visibility="{x:Bind Current.Content, Converter={StaticResource LineCountToVis}, ConverterParameter='HideIfSmall'}">
									<StackPanel Visibility="{Binding ElementName=RootControl, Path=ViewModel.IsComparisonMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
										<TextBlock Text="REF" FontSize="8" FontWeight="Bold"/>
										<TextBlock Text="{x:Bind Reference.Timestamp, Mode=OneWay, TargetNullValue='--'}" FontSize="8"/>
									</StackPanel>
								</StackPanel>
							</StackPanel>
						</Grid>

						<Grid Grid.Column="2"
                              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                              BorderThickness="0,0,1,0"
                              PointerPressed="OnBlockPointerPressed">

							<components:SegmentCodeViewer 
                                    x:Name="CodeEditor"
                                    Text="{x:Bind Current.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    FileExtension="{x:Bind Current.FileExtension, Mode=OneWay}"
                                    SaveRequested="OnSegmentSaveRequested"
                                    ContentModified="OnSegmentContentModified"
                                    CaretPositionChanged="OnEditorCaretPositionChanged"/>
						</Grid>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
			<FontIcon Glyph="&#xE9CE;" FontSize="40" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
			<TextBlock Text="No code blocks found" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
		</StackPanel>

		<components:VersionFooter Grid.Row="2"
                                  SymbolInfo="{x:Bind ViewModel.CurrentSymbolInfo, Mode=OneWay}"
                                  GlobalVersions="{x:Bind ViewModel.GlobalHistory, Mode=OneWay}"
                                  SelectedGlobalIndex="{x:Bind ViewModel.CurrentGlobalIndex, Mode=TwoWay}"
                                  CanSave="{x:Bind ViewModel.HasAnyUnsavedChanges, Mode=OneWay}"
                                  IsComparisonMode="{x:Bind ViewModel.IsComparisonMode, Mode=TwoWay}"
                                  HideUnchanged="{x:Bind ViewModel.HideUnchangedBlocks, Mode=TwoWay}"
                                  LeftIndex="{x:Bind ViewModel.CompareLeftIndex, Mode=TwoWay}"
                                  RightIndex="{x:Bind ViewModel.CurrentGlobalIndex, Mode=OneWay}"
                                  SaveNewVersionRequested="OnFooterSaveNewVersion"
                                  SaveOverwriteRequested="OnFooterSaveOverwrite"
                                  RestoreOriginalRequested="OnFooterRestoreOriginal"
                                  SaveToFileRequested="OnFooterSaveToFile"/>
		<Grid Grid.RowSpan="3" 
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.8"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
			<ProgressRing IsActive="True"/>
		</Grid>
	</Grid>
</UserControl>