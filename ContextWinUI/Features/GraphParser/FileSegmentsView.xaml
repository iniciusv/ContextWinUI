<UserControl
    x:Class="ContextWinUI.Features.GraphParser.Views.FileSegmentsView"
    x:Name="RootUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ContextWinUI.Features.GraphParser.ViewModels"
    xmlns:models="using:ContextWinUI.Features.GraphParser.Models"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:localComp="using:ContextWinUI.Features.GraphParser.Views.Components"
    xmlns:versionComp="using:ContextWinUI.Features.GraphParser.Views.Components"
    mc:Ignorable="d">

	<UserControl.Resources>
		<converters:BoolToVisibilityConverter x:Key="VisibleIfTrue" TrueValue="Visible" FalseValue="Collapsed"/>
		<converters:BoolToVisibilityConverter x:Key="CollapsedIfTrue" TrueValue="Collapsed" FalseValue="Visible"/>
		<converters:BoolToVisibilityConverter x:Key="NullToCollapsed" TrueValue="Collapsed" FalseValue="Visible"/>
	</UserControl.Resources>

	<Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0"
                      x:Name="MainScrollViewer"
                      Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource CollapsedIfTrue}}"
                      Padding="0" 
                      VerticalScrollBarVisibility="Auto">

			<ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" Margin="0">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:SegmentRowViewModel">

						<Grid Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource VisibleIfTrue}}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                              BorderThickness="0,0,0,1">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="{Binding DataContext.LeftColumnWidth, ElementName=RootUserControl}"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Grid Grid.Column="0"
                                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                  BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                  BorderThickness="0,0,1,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="85"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<Grid Grid.Column="0" 
                                      Background="{ThemeResource LayerFillColorAltBrush}" 
                                      Padding="8,0" 
                                      BorderThickness="0,0,1,0" 
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

									<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Opacity="0.6">
										<TextBlock Text="{x:Bind Reference.TypeDescription}" 
                                                   FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
									</StackPanel>
								</Grid>

								<localComp:SegmentCodeViewer Grid.Column="1"
                                                             Text="{x:Bind Reference.Content, Mode=OneWay}" 
                                                             FileExtension="{x:Bind Reference.FileExtension, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             VerticalAlignment="Stretch"
                                                             HorizontalAlignment="Stretch"/>
							</Grid>

							<Grid Grid.Column="1"
                                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                  PointerPressed="OnBlockPointerPressed">

								<Grid.ContextFlyout>
									<MenuFlyout>
										<MenuFlyoutItem Text="Inserir Bloco Abaixo" Icon="Add"
                                                        Command="{Binding DataContext.AddSiblingBlockCommand, ElementName=RootUserControl}"
                                                        CommandParameter="{x:Bind Current}"/>

										<MenuFlyoutItem Text="Excluir Bloco" Icon="Delete" Foreground="Red"
                                                        Command="{Binding DataContext.DeleteBlockCommand, ElementName=RootUserControl}"
                                                        CommandParameter="{x:Bind Current}"/>

										<MenuFlyoutSeparator/>

										<MenuFlyoutItem Text="Reverter para Original" Icon="Undo"
                                                        Command="{Binding DataContext.RevertBlockToOriginalCommand, ElementName=RootUserControl}"
                                                        CommandParameter="{x:Bind Current}"/>

										<MenuFlyoutItem Text="Desvincular (Tratar como Novo)"
                                                        Command="{Binding DataContext.PromoteEditToNewBlockCommand, ElementName=RootUserControl}"
                                                        CommandParameter="{x:Bind Current}">
											<MenuFlyoutItem.Icon>
												<FontIcon Glyph="&#xE106;"/>
											</MenuFlyoutItem.Icon>
										</MenuFlyoutItem>
									</MenuFlyout>
								</Grid.ContextFlyout>

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="85"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<Rectangle x:Name="SelectionIndicator"
                                           Fill="{ThemeResource SystemAccentColor}"
                                           Width="3" HorizontalAlignment="Left" Visibility="Collapsed"/>

								<Grid Grid.Column="0" 
                                      Background="{ThemeResource LayerFillColorAltBrush}" 
                                      Padding="8,0" 
                                      BorderThickness="0,0,1,0" 
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      ToolTipService.ToolTip="{x:Bind Current.Name}">

									<Rectangle HorizontalAlignment="Left" Width="3" VerticalAlignment="Stretch" 
                                               Fill="{x:Bind Current.HeaderBrush}" Margin="-8,0,0,0"/>

									<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Opacity="0.9">
										<FontIcon Glyph="&#xE81C;" FontSize="10" Foreground="{ThemeResource SystemAccentColor}"
                                                  Visibility="{x:Bind Current.HasUnsavedChanges, Converter={StaticResource VisibleIfTrue}}"/>

										<FontIcon Glyph="{x:Bind Current.Icon}" Foreground="{x:Bind Current.HeaderBrush}" FontSize="10"/>

										<TextBlock Text="{x:Bind Current.TypeDescription}" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
									</StackPanel>
								</Grid>

								<localComp:SegmentCodeViewer Grid.Column="1"
                                                             Text="{x:Bind Current.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                             FileExtension="{x:Bind Current.FileExtension, Mode=OneWay}"
                                                             SaveRequested="OnSegmentSaveRequested"
                                                             ContentModified="OnSegmentContentModified"
                                                             GotFocus="OnSegmentGotFocus"/>
							</Grid>

						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource VisibleIfTrue}}">
			<TextBlock Text="Nenhum conteúdo granular" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
		</StackPanel>

		<versionComp:VersionFooter Grid.Row="1"
                                   GlobalVersions="{x:Bind ViewModel.GlobalHistory, Mode=OneWay}"
                                   SelectedGlobalIndex="{x:Bind ViewModel.CurrentGlobalIndex, Mode=TwoWay}"
                                   CanSave="{x:Bind ViewModel.HasAnyUnsavedChanges, Mode=OneWay}"
                                   TargetBlock="{x:Bind ViewModel.SelectedBlock, Mode=OneWay}"
                                   IsComparisonMode="{x:Bind ViewModel.IsComparisonMode, Mode=TwoWay}"
                                   LeftIndex="{x:Bind ViewModel.CompareLeftIndex, Mode=TwoWay}"
                                   RightIndex="{x:Bind ViewModel.CurrentGlobalIndex, Mode=TwoWay}"
                                   SaveNewVersionRequested="OnSaveNewVersionRequested"
                                   SaveOverwriteRequested="OnSaveOverwriteRequested"
                                   RestoreOriginalRequested="OnRestoreOriginalRequested" />
	</Grid>
</UserControl>