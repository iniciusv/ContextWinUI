<UserControl
    x:Class="ContextWinUI.Features.GraphParser.Views.Components.SegmentCodeViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
		<ScrollViewer x:Name="EditorScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" 
                      ZoomMode="Enabled"
                      MinZoomFactor="0.5"
                      MaxZoomFactor="4.0"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Top">

			<Grid Margin="0,0,0,0">

				<RichEditBox x:Name="CodeEditor"
                             IsSpellCheckEnabled="False"
                             IsTextPredictionEnabled="False"
                             FontFamily="Consolas, Courier New, Monospace"
                             FontSize="14"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             MinHeight="0"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="NoWrap"
                             TextChanged="CodeEditor_TextChanged"
                             KeyDown="CodeEditor_KeyDown"
                             BringIntoViewRequested="CodeEditor_BringIntoViewRequested"
                             Padding="0,2,0,2"
                             Background="Transparent"/>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>