<UserControl
    x:Class="ContextWinUI.Features.GraphParser.Views.Components.VersionFooter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ContextWinUI.Features.GraphParser.Models"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d">

	<UserControl.Resources>
		<converters:BoolToVisibilityConverter x:Key="VisibleIfTrue" TrueValue="Visible" FalseValue="Collapsed"/>
		<converters:BoolToVisibilityConverter x:Key="CollapsedIfTrue" TrueValue="Collapsed" FalseValue="Visible"/>

		<Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="4"/>
			<Setter Property="MinWidth" Value="32"/>
			<Setter Property="MinHeight" Value="32"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</UserControl.Resources>

	<Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0"
          Padding="12,8">

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="0" 
                    Orientation="Horizontal" 
                    Spacing="8"
                    VerticalAlignment="Center">

			<FontIcon Glyph="&#xF133;" 
                      FontSize="12"
                      Foreground="Orange"
                      Visibility="{x:Bind CanSave, Mode=OneWay, Converter={StaticResource VisibleIfTrue}}"/>

			<TextBlock Text="Alterações Pendentes"
                       Visibility="{x:Bind CanSave, Mode=OneWay, Converter={StaticResource VisibleIfTrue}}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="Orange"/>

			<TextBlock Text="Sincronizado"
                       Visibility="{x:Bind CanSave, Mode=OneWay, Converter={StaticResource CollapsedIfTrue}}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="Green"
                       Opacity="0.8"/>
		</StackPanel>

		<StackPanel Grid.Column="1" 
                    Orientation="Horizontal" 
                    Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

			<Button Click="OnRestoreOriginalClick"
                    ToolTipService.ToolTip="Restaurar versão original"
                    IsEnabled="{x:Bind CanNavigatePrevious, Mode=OneWay}"
                    Style="{StaticResource DefaultButtonStyle}">
				<StackPanel Orientation="Horizontal" Spacing="4">
					<FontIcon Glyph="&#xE7B7;" FontSize="12"/>
					<TextBlock Text="Original"/>
				</StackPanel>
			</Button>

			<Button Click="OnPreviousVersionClick"
                    ToolTipService.ToolTip="Versão anterior"
                    IsEnabled="{x:Bind CanNavigatePrevious, Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}">
				<FontIcon Glyph="&#xE76B;" FontSize="12"/>
			</Button>

			<ComboBox ItemsSource="{x:Bind GlobalVersions, Mode=OneWay}"
                      SelectedIndex="{x:Bind SelectedGlobalIndex, Mode=TwoWay}"
                      MinWidth="220">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="models:GlobalVersion">
						<StackPanel Margin="4,2">
							<TextBlock Text="{x:Bind Description}" 
                                       FontWeight="SemiBold"/>

							<TextBlock Text="{x:Bind Timestamp}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind IsOriginal, Converter={StaticResource CollapsedIfTrue}}"/>
						</StackPanel>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<Button Click="OnNextVersionClick"
                    ToolTipService.ToolTip="Próxima versão"
                    IsEnabled="{x:Bind CanNavigateNext, Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}">
				<FontIcon Glyph="&#xE76C;" FontSize="12"/>
			</Button>

			<Button Click="OnSaveVersionClick"
                    ToolTipService.ToolTip="Salvar nova versão global"
                    IsEnabled="{x:Bind CanSave, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
				<StackPanel Orientation="Horizontal" Spacing="4">
					<FontIcon Glyph="&#xE74E;" FontSize="12"/>
					<TextBlock Text="Salvar Versão"/>
				</StackPanel>
			</Button>

		</StackPanel>

		<StackPanel Grid.Column="2" 
                    Orientation="Horizontal" 
                    Spacing="4"
                    VerticalAlignment="Center">
			<TextBlock Text="Versão:"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.6"/>
			<TextBlock Text="{x:Bind VersionCounterText, Mode=OneWay}"
                       FontWeight="SemiBold"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
		</StackPanel>

	</Grid>
</UserControl>