<UserControl
    x:Class="ContextWinUI.Features.Parser.ParserEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:ContextWinUI.Views.Components"
    xmlns:models="using:ContextWinUI.Core.Models"
    xmlns:local="using:ContextWinUI.Features.Parser"
    mc:Ignorable="d"
    x:Name="RootControl">

	<Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" 
                Padding="12,8" 
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,16,0">
					<TextBlock Text="Contexto no Cursor" 
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
					<TextBlock Text="{x:Bind ViewModel.CurrentFilePath, Mode=OneWay}" 
                               FontSize="10" 
                               TextTrimming="CharacterEllipsis" 
                               MaxWidth="200"
                               Opacity="0.6"/>
				</StackPanel>

				<ScrollViewer Grid.Column="1" 
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollMode="Disabled" 
                              HorizontalScrollMode="Enabled">
					<ItemsControl ItemsSource="{x:Bind ViewModel.ActiveSymbols, Mode=OneWay}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" Spacing="8"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="models:SymbolNode">
								<Button Command="{Binding ElementName=RootControl, Path=ViewModel.PasteFromClipboardToSymbolCommand}"
                                        CommandParameter="{x:Bind}"
                                        Padding="8,6"
                                        CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        ToolTipService.ToolTip="Clique para Colar ou Refatorar">

									<StackPanel Orientation="Horizontal" Spacing="8">
										<FontIcon Glyph="&#xE943;" FontSize="12" FontFamily="Segoe MDL2 Assets"
                                                  Visibility="{x:Bind local:ParserEditorView.IsTypeVisible(Type, 'Class')}"/>
										<FontIcon Glyph="&#xEA86;" FontSize="12" FontFamily="Segoe MDL2 Assets"
                                                  Visibility="{x:Bind local:ParserEditorView.IsTypeVisible(Type, 'Method')}"/>
										<FontIcon Glyph="&#xE8A5;" FontSize="12" FontFamily="Segoe MDL2 Assets"
                                                  Visibility="{x:Bind local:ParserEditorView.IsTypeVisible(Type, 'Property')}"/>

										<StackPanel>
											<TextBlock Text="{x:Bind Name}" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold"/>
											<TextBlock Text="{x:Bind Type}" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
										</StackPanel>

										<Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" 
                                                CornerRadius="2" Padding="4,0" Margin="4,0,0,0">
											<StackPanel Orientation="Horizontal" Spacing="4">
												<FontIcon Glyph="&#xE77F;" FontSize="10"/>
												<TextBlock Text="Colar/Refatorar" FontSize="9"/>
											</StackPanel>
										</Border>
									</StackPanel>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<Button Grid.Column="2" 
                        Command="{x:Bind ViewModel.AnalyzeClipboardCommand}"
                        Margin="8,0,0,0"
                        Padding="8"
                        CornerRadius="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        ToolTipService.ToolTip="Recarregar Contexto do Clipboard">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<FontIcon Glyph="&#xE896;" FontSize="14" FontFamily="Segoe MDL2 Assets"/>
						<TextBlock Text="Analisar Clipboard" FontSize="12" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>

			</Grid>
		</Border>

		<components:CodeEditorControl x:Name="EditorControl"
                                      Grid.Row="1"
                                      Text="{x:Bind ViewModel.CodeContent, Mode=TwoWay}"
                                      FileExtension=".cs"
                                      ContextNodes="{x:Bind ViewModel.FileSymbols, Mode=OneWay}" 
                                      CaretPositionChanged="OnCaretPositionChanged"/>
	</Grid>
</UserControl>