<UserControl
    x:Class="ContextWinUI.Views.Components.ContextGitView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ContextWinUI.Models"
    xmlns:coreModels="using:ContextWinUI.Core.Models"
    xmlns:components="using:ContextWinUI.Views.Components"
    xmlns:converters="using:ContextWinUI.Helpers.Converters">

	<UserControl.Resources>
		<converters:BoolToTextDecorationsConverter x:Key="BoolToDecConverter"/>
        <converters:CountToBoolConverter x:Key="CountToBoolConverter"/>
	</UserControl.Resources>

	<Grid>
        <Pivot SelectedIndex="{x:Bind ViewModel.SelectedPivotIndex, Mode=TwoWay}">
            <PivotItem Header="Changes">
                <!-- EXISTING CHANGES VIEW -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Modified Files" Margin="16,8" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="14"/>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.ModifiedItems, Mode=OneWay}"
                              SelectionMode="Extended"
                              IsItemClickEnabled="True"
                              ItemClick="ListView_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileSystemItem">
                                <Grid Padding="0,4">
                                    <Grid.ContextFlyout>
                                        <Flyout Opening="OnTagMenuOpening" />
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind Icon}" FontSize="12" Foreground="DarkOrange"/>

                                            <TextBlock Text="{x:Bind Name}" 
                                                       FontWeight="SemiBold"
                                                       TextDecorations="{x:Bind IsDeleted, Converter={StaticResource BoolToDecConverter}, Mode=OneWay}"/>

                                            <components:TagChipsControl TagsSource="{x:Bind Tags, Mode=OneWay}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind FullPath}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#20FFA500" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="MOD" FontSize="9" Foreground="DarkOrange" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="2" Padding="16,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RefreshChangesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;"/>
                                <TextBlock Text="Refresh Git Status"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </PivotItem>

            <PivotItem Header="History">
                <!-- NEW HISTORY VIEW -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CommandBar DefaultLabelPosition="Right" IsOpen="False">
                        <AppBarButton Icon="Refresh" Label="Reload History" Command="{x:Bind ViewModel.LoadHistoryCommand}"/>
                        <AppBarButton Label="Select Modified Files" Command="{x:Bind ViewModel.SelectAllModifiedFilesCommand}"
                                      IsEnabled="{x:Bind ViewModel.SelectedCommits.Count, Mode=OneWay, Converter={StaticResource CountToBoolConverter}}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE73A;"/> <!-- CheckList -->
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Compare Selected" Command="{x:Bind ViewModel.CompareSelectedCommitsCommand}"
                                      IsEnabled="{x:Bind ViewModel.SelectedCommits.Count, Mode=OneWay, Converter={StaticResource CountToBoolConverter}}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE11E;"/> <!-- Symbol.Switch / Compare equivalent -->
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
                              SelectionMode="Extended"
                              SelectionChanged="HistoryList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="coreModels:GitCommitItem">
                                <Grid Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Width="80">
                                        <TextBlock Text="{x:Bind ShortSha}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="Bold" FontFamily="Consolas"/>
                                        <TextBlock Text="{x:Bind FormattedDate}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{x:Bind Message}" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind Author}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <Grid Grid.Row="2" Padding="16,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBlock Text="Select commits to compare changes." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
	</Grid>
</UserControl>