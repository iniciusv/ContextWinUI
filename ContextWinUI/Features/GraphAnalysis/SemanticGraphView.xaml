<UserControl
    x:Class="ContextWinUI.Features.GraphAnalysis.SemanticGraphView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ContextWinUI.Features.GraphAnalysis"
    xmlns:ui="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d">

	<UserControl.Resources>
		<ui:BoolToVisibilityConverter x:Key="BoolToVis" 
                                      TrueValue="Visible" 
                                      FalseValue="Collapsed"/>

		<ui:BoolToObjectConverter x:Key="BoolToWeight">
			<ui:BoolToObjectConverter.TrueValue>
				<FontWeight>Bold</FontWeight>
			</ui:BoolToObjectConverter.TrueValue>
			<ui:BoolToObjectConverter.FalseValue>
				<FontWeight>Normal</FontWeight>
			</ui:BoolToObjectConverter.FalseValue>
		</ui:BoolToObjectConverter>

		<ui:BoolToObjectConverter x:Key="BoolToBrush">
			<ui:BoolToObjectConverter.TrueValue>
				<SolidColorBrush Color="DarkOrange"/>
			</ui:BoolToObjectConverter.TrueValue>
			<ui:BoolToObjectConverter.FalseValue>
				<SolidColorBrush Color="{ThemeResource SystemBaseHighColor}"/>
			</ui:BoolToObjectConverter.FalseValue>
		</ui:BoolToObjectConverter>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Padding="12,12,12,8">
			<AutoSuggestBox PlaceholderText="Buscar símbolo (Classe, Método...)"
                            QueryIcon="Find"
                            ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}"
                            TextChanged="OnSearchTextChanged"
                            SuggestionChosen="OnSuggestionChosen"
                            QuerySubmitted="OnQuerySubmitted"
                            HorizontalAlignment="Stretch">
				<AutoSuggestBox.ItemTemplate>
					<DataTemplate x:DataType="local:GraphNodeViewModel">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<FontIcon Glyph="{x:Bind IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
							<StackPanel>
								<TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
								<TextBlock Text="{x:Bind Details}" FontSize="10" Foreground="Gray"/>
							</StackPanel>
						</StackPanel>
					</DataTemplate>
				</AutoSuggestBox.ItemTemplate>
			</AutoSuggestBox>
		</Grid>

		<TreeView Grid.Row="1" 
                  ItemsSource="{x:Bind ViewModel.RootNodes, Mode=OneWay}"
                  ItemInvoked="OnItemInvoked"
                  Padding="0,0,0,0">
			<TreeView.ItemTemplate>
				<DataTemplate x:DataType="local:GraphNodeViewModel">
					<TreeViewItem ItemsSource="{x:Bind Children, Mode=OneWay}" 
                                  IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                  Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">

						<StackPanel Orientation="Horizontal" Spacing="6">
							<FontIcon Glyph="{x:Bind IconGlyph}" 
                                      FontFamily="Segoe MDL2 Assets" 
                                      FontSize="12"
                                      Foreground="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToBrush}}"/>

							<TextBlock Text="{x:Bind Name}">
								<TextBlock.FontWeight>
									<Binding Path="IsSelected" Converter="{StaticResource BoolToWeight}"/>
								</TextBlock.FontWeight>
								<TextBlock.Foreground>
									<Binding Path="IsSelected" Converter="{StaticResource BoolToBrush}"/>
								</TextBlock.Foreground>
							</TextBlock>

							<TextBlock Text="{x:Bind ExtraInfo}" Foreground="Gray" FontSize="11" 
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</TreeViewItem>
				</DataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>

		<Grid Grid.Row="2" 
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="12,6">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<ProgressBar Grid.Row="0" Grid.ColumnSpan="2" 
                         IsIndeterminate="True" 
                         VerticalAlignment="Top"
                         Margin="-12,-6,-12,6"
                         Height="2"
                         Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

			<TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                       VerticalAlignment="Center" 
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

			<Button Grid.Row="1" Grid.Column="1"
                    Command="{x:Bind ViewModel.LoadGraphCommand}"
                    Background="Transparent" 
                    BorderThickness="0"
                    Padding="6,4"
                    Height="32"
                    ToolTipService.ToolTip="Reload Graph">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<FontIcon Glyph="&#xE72C;" FontSize="12" />
					<TextBlock Text="Reload" FontSize="12"/>
				</StackPanel>
			</Button>
		</Grid>
	</Grid>
</UserControl>
