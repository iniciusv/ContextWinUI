<UserControl
    x:Class="ContextWinUI.Features.GraphAnalysis.SemanticGraphView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ContextWinUI.Features.GraphAnalysis"
    mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Orientation="Horizontal" Padding="10" Spacing="10">
			<Button Command="{x:Bind ViewModel.LoadGraphCommand}" Content="Recarregar Grafo" />
			<TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
		</StackPanel>

		<TreeView Grid.Row="1" 
                  ItemsSource="{x:Bind ViewModel.RootNodes, Mode=OneWay}"
                  ItemInvoked="OnItemInvoked">
			<TreeView.ItemTemplate>
				<DataTemplate x:DataType="local:GraphNodeViewModel">
					<TreeViewItem ItemsSource="{x:Bind Children, Mode=OneWay}" 
                                  IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<FontIcon Glyph="{x:Bind IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
							<TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
							<TextBlock Text="{x:Bind ExtraInfo}" Foreground="Gray" FontSize="11" 
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</TreeViewItem>
				</DataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>

		<ProgressBar Grid.Row="2" IsIndeterminate="True" 
                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
	</Grid>
</UserControl>